#!/usr/bin/env bash
# Deployed to ~/.local/libexec/sklein-devbox/opencode-port-free, off PATH: it is
# the first command of the `opencode-server` daemon's run script, no human types
# its name.
#
# opencode-port-free - give port 4096 back to the shared OpenCode server before
# it starts.
#
# A server started by a client can still hold the port when pitchfork starts the
# daemon (seen on 2026-10-29), and `opencode serve` then exits. This script
# stops the holder before the server is exec'd.
#
# It leaves a process in the pitchfork tree alone: when the supervisor restarts
# the daemon, the old server is either gone or still its child, and killing it
# here would make the new one fail to bind for no reason.
set -u

port=4096

listener_pid() {
  ss -ltnpH "sport = :${port}" 2>/dev/null |
    sed -n 's/.*pid=\([0-9]\+\).*/\1/p' | head -1
}

# True when the process belongs to the pitchfork supervisor's tree.
is_supervised() {
  local p="$1" i=0 comm
  while [ -n "$p" ] && [ "$p" -gt 1 ] && [ "$i" -lt 15 ]; do
    comm="$(ps -o comm= -p "$p" 2>/dev/null || true)"
    [ "$comm" = "pitchfork" ] && return 0
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
    i=$((i + 1))
  done
  return 1
}

pid="$(listener_pid)"
if [ -z "$pid" ]; then
  echo "opencode-port-free: port $port is free"
  exit 0
fi

if is_supervised "$pid"; then
  echo "opencode-port-free: PID $pid is supervised by pitchfork, leaving it"
  exit 0
fi

comm="$(ps -o comm= -p "$pid" 2>/dev/null || true)"
case "$comm" in
  *opencode*) ;;
  *)
    echo "opencode-port-free: port $port held by PID $pid ($comm), not an opencode process; refusing to touch it" >&2
    exit 1
    ;;
esac

echo "opencode-port-free: port $port held by PID $pid ($comm), stopping it"
kill "$pid" 2>/dev/null || true

i=0
while [ "$i" -lt 25 ]; do
  [ -z "$(listener_pid)" ] && {
    echo "opencode-port-free: port $port is free"
    exit 0
  }
  sleep 0.2
  i=$((i + 1))
done

echo "opencode-port-free: port $port still busy, sending SIGKILL to $pid" >&2
kill -9 "$pid" 2>/dev/null || true
sleep 0.2

if [ -n "$(listener_pid)" ]; then
  echo "opencode-port-free: could not free port $port" >&2
  exit 1
fi

echo "opencode-port-free: port $port is free"
exit 0
