#!/bin/sh
# Launch wrapper forced by sshd (Match User devbox / ForceCommand) so tmux
# starts by default on interactive login, whatever the user's shell is.
#
# Behaviour:
#   - a command was requested by the client (ssh host <cmd>, rsync, sftp)
#     -> run it unchanged
#   - no tty allocated (e.g. plain `ssh host` without -t)
#     -> plain login shell, no tmux
#   - otherwise -> tmux session grouped with the shared "main" workspace
#     (tmux session groups / screen -x model): every console shares the
#     same windows and panes but keeps its own current window
#
# Opt-out without tmux: `ssh -t host bash` (or zsh/fish, `bash -l` for a
# login shell). The requested command is routed below, so tmux is simply
# not launched for such sessions.
set -eu

# sshd's ForceCommand session is not a login session: /etc/locale.conf is not
# applied, so LANG is empty and LC_CTYPE falls back to POSIX. tmux then renders
# every non-ASCII character (the starship prompt glyph "➜", accents, ...) as
# "_" (see tmux(1): without -u or a "UTF-8" LC_CTYPE, non-ASCII output is
# replaced by underscores). tmux decides this when the client connects, so the
# locale must be set here, before any tmux call.
export LANG=C.UTF-8

# tmux is a mise-managed tool. sshd's ForceCommand does not source the shell
# rc files, so the mise shims are not on PATH. Prepend the shim directory: it
# is version-agnostic and resolves tmux through the mise config
# (~/.config/mise/config.toml), unlike the installs/tmux/latest alias which
# tracks the highest installed build rather than the configured one.
PATH="$HOME/.local/share/mise/shims:$PATH"
export PATH

# Remote-desktop link: the foot host forwards its session bus and audio
# server into the instance over two reverse-unix-socket ssh forwards. Export
# the sockets so tmux (exec'd below) and the panes it spawns reach the foot
# host (notify-send, xdg-open, paplay...).
export DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/foot-host-bus
export PULSE_SERVER=unix:/tmp/foot-host-pulse

login_shell=$(getent passwd "$(id -un)" | cut -d: -f7)
login_shell=${login_shell:-/bin/sh}

if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
  case "$SSH_ORIGINAL_COMMAND" in
    *sftp-server*) exec /usr/libexec/openssh/sftp-server ;;
    *)             exec "$login_shell" -c "$SSH_ORIGINAL_COMMAND" ;;
  esac
fi

# No pseudo-terminal: not an interactive console session, do not start tmux.
[ -t 0 ] || exec "$login_shell"

# --- Shared workspace in grouped sessions (screen -x model) ---
# "main" is the anchor session hosting the shared windows/panes. Each ssh
# console attaches its own session grouped with main: same windows, but an
# independent current window per console.
#
# Console sessions are kept after a client detaches; unattached ones are
# reaped on the next login. Full manual cleanup:
#   tmux kill-session -a -t main   (kills every session except main)
if ! tmux has-session -t main 2>/dev/null; then
  tmux new-session -d -s main 2>/dev/null || true
fi

tmux list-sessions -F '#{session_attached}:#{session_name}' 2>/dev/null |
while IFS=: read -r attached name; do
  case "$name" in
    console-*) ;;
    *) continue ;;
  esac
  [ "$attached" = 0 ] || continue
  tmux kill-session -t "$name" 2>/dev/null || true
done

console_session="console-$(date +%s)-$$"
tmux new-session -d -t main -s "$console_session" 2>/dev/null || true
exec tmux attach-session -t "$console_session"
