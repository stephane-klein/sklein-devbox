#- The proxy TLD is the host's own FQDN: each instance exposes
#   <daemon>.<project>.<fqdn>. `~/bin/sklein-devbox-ingress` derives the same
#   value from `hostname -f`, so both must stay in sync.
{%- set fqdn = exec(command="hostname -f") -%}
{%- if "." not in fqdn %}{{ throw(message="pitchfork config.toml: `hostname -f` did not return an FQDN") }}{% endif %}

[settings.web]
auto_start = true
bind_port = 3120
bind_address = "127.0.0.1"

[daemons.chromium-headless]
run = """
chromium-browser --headless=new  --remote-debugging-port=9222  --remote-debugging-address=0.0.0.0  --remote-allow-origins="*"  --no-sandbox --window-size=1920,1200 --use-gl=angle --use-angle=swiftshader
"""
retry = true

[daemons.opencode-server]
# OpenCode 2: `serve --service` runs the shared server in the foreground and
# registers it in ~/.local/state/opencode/service.json, so every client (TUI,
# CLI, OpenChamber) discovers its URL and password without any flag. Port,
# hostname and password come from `opencode service set` (see the mise
# post-dotfiles hook); pitchfork keeps the process supervised and logs it.
run = "mise exec -- opencode serve --service"
retry = true
# Readiness: pitchfork starts dependents (openchamber) once the port listens.
port = 4096
# Come back with the supervisor: without this, a `supervisor start --force`
# (e.g. reloading the proxy TLD) leaves the server down, and the next OpenCode
# client starts an unsupervised `serve --service` that then holds port 4096,
# making every later `pitchfork start global/opencode-server` fail.
boot_start = true

[daemons.openchamber]
run = """
export XDG_RUNTIME_DIR=/tmp/user/1000
export GOPASS_AGE_NO_CONFIRM=1
export OPENCODE_SKIP_START=true
export OPENCODE_PORT=4096
export OPENCODE_SERVER_PASSWORD={{ secret(name="OPENCODE_SERVER_PASSWORD") }}
OPENCHAMBER_UI_PASSWORD={{ secret(name="OPENCHAMBER_UI_PASSWORD") }}
export OPENCHAMBER_UI_PASSWORD
exec mise exec -- openchamber --lan --port 3000 --foreground
"""
retry = true
depends = ["opencode-server"]
port = 3000
boot_start = true

# --- sklein-devbox-ingress ---------------------------------------------------
# Wildcard subdomains over NetBird + a per-hostname TLS reverse proxy in front
# of the daemons above. Driven by ~/bin/sklein-devbox-ingress (up/down/status).
#
#   - a NetBird Custom DNS Zone for <tld> holds a wildcard A record
#     *.<tld> -> the wt0 address (the script maintains it through the API).
#     NetBird resolves it as part of its authoritative peer DNS domain, so no
#     DNS daemon runs on this host; a wildcard matches one label level only.
#   - the proxy routes <daemon>.<project>.<tld>, plus any extra label on the
#     left (proxy.wildcard), and signs a per-hostname certificate with its
#     local CA ($PITCHFORK_STATE_DIR/proxy/ca.pem, to distribute to clients).
#     DNS only covers one label (<slug>.<tld>), so project daemons and
#     extra-left-label hostnames are routed but not resolvable from peers.
#
# `host = "0.0.0.0"` lets the proxy listen on the (dynamic) wt0 address so
# NetBird peers can reach it; it therefore also listens on the other
# interfaces. `port = 443` relies on the bind capability granted once by
# `pitchfork proxy setup` (re-run by the script's `up`).
[settings.proxy]
enable = true
https = true
tld = "{{ fqdn }}"
wildcard = true
host = "0.0.0.0"
port = 443

# Route the global daemons above through the proxy. Global daemons have no
# project hostname, so they need a slug; <slug>.<tld> is what peers resolve
# (the DNS wildcard covers one label level only).
[slugs]
openchamber     = { dir = "~", daemon = "openchamber" }
