#!/usr/bin/env bash
# gpg-signing-doctor - check GPG signing (git, jj) from inside the instance.
#
# git and jj delegate signing to gpg, which asks gpg-agent, which launches the
# pinentry configured in gpg-agent.conf. In this instance that is the vendored
# pinentry-tmux, which shows the prompt in a tmux popup. This doctor checks the
# whole chain and, above all, that a missing or failing popup fails fast with
# "No pinentry" instead of blocking the caller forever.
#
# The automated checks need no passphrase and never touch the real key cache:
# they drive pinentry-tmux against a fake tmux and a stub pinentry. The guided
# check creates a throwaway key in a temporary GNUPGHOME, with a passphrase
# printed on screen, so it exercises the real popup without touching the real
# key, its 24 h cache, or the agent of the real GNUPGHOME.
#
# Companion of sklein-devbox-doctor (remote-desktop link), which runs it with
# --with-gpg and delegates to it with --only-gpg.

set -u

PROG="${0##*/}"
PINENTRY_TMUX="${PINENTRY_TMUX:-$HOME/bin/pinentry-tmux}"
GPG_AGENT_CONF="${GNUPGHOME:-$HOME/.config/gnupg}/gpg-agent.conf"
TMP="${TMPDIR:-/tmp}"
# Passphrase of the throwaway key used by the guided check. It is printed on
# purpose: the key lives in a temporary GNUPGHOME that is removed afterwards.
TEST_PASSPHRASE="doctor-passphrase"

pass=0
fail=0
skip=0

# Empty runs every check; otherwise the name of the single check to run.
ONLY=""
KEY=""

if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_FAIL=$'\033[31m'; C_OFF=$'\033[0m'
else
  C_OK=; C_FAIL=; C_OFF=
fi

usage() {
  cat <<EOF
$PROG - check GPG signing (git, jj) through pinentry-tmux.

Verifies that the signing chain is wired (gpg -> gpg-agent -> pinentry-tmux ->
tmux popup), that it fails fast when no popup can be shown, and, guided, that a
real passphrase can be entered and a signature produced.

The guided check uses a throwaway key in a temporary GNUPGHOME: your own key,
cache and agent are never touched.

Usage:
  $PROG [options]

Options:
  -h, --help          Show this help
      --key KEY       Signing key to report on (default: git, then jj config)
      --only-config   Inventory only
      --only-fallback No attached client must fail fast
      --only-timeout  A popup that cannot open must fail fast
      --only-relay    Popup relay through a stub pinentry (a window flashes)
      --only-sign     Guided signature with a throwaway key (needs a TTY)
EOF
}

die() { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 2; }

step() { printf '\n== %s\n' "$1"; }
record_pass() { printf '   %sok%s   %s\n' "$C_OK" "$C_OFF" "$1"; pass=$((pass + 1)); }
record_fail() { printf '   %sfail%s %s\n' "$C_FAIL" "$C_OFF" "$1"; fail=$((fail + 1)); }
record_skip() { printf '   skip %s\n' "$1"; skip=$((skip + 1)); }

ask() { # ask "question" -> success on yes
  local answer
  printf '   %s [y/N] ' "$1"
  IFS= read -r answer || return 1
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

want() { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }

# --- inventory ---------------------------------------------------------------

pinentry_program() {
  awk '/^[[:space:]]*pinentry-program[[:space:]]/ { sub(/^[[:space:]]*pinentry-program[[:space:]]+/, ""); print; exit }' \
    "$GPG_AGENT_CONF" 2>/dev/null
}

agent_pid() {
  gpg-connect-agent 'GETINFO pid' /bye 2>/dev/null \
    | awk '/^D [0-9]+$/ { print $2; exit }'
}

signing_key() {
  if [ -n "$KEY" ]; then
    printf '%s' "$KEY"
    return 0
  fi
  local key
  key="$(git config --get user.signingkey 2>/dev/null || true)"
  if [ -n "$key" ]; then
    printf '%s' "$key"
    return 0
  fi
  jj config get signing.key 2>/dev/null || true
}

keygrip_of() {
  gpg --with-colons --with-keygrip --list-secret-keys "$1" 2>/dev/null \
    | awk -F: '$1 == "grp" { print $10; exit }'
}

# Probe the agent's cache without any side effect: --pinentry-mode error makes
# the signature succeed only when the passphrase (or key material) is already
# available, and fail at once otherwise.
key_unlocked() {
  printf 'gpg-signing-doctor probe\n' \
    | gpg --batch --pinentry-mode error --clearsign -u "$1" >/dev/null 2>&1
}

test_inventory() {
  step "inventory"
  local configured configured_real key grip
  configured="$(pinentry_program)"
  configured_real=""
  [ -n "$configured" ] && configured_real="$(readlink -f "$configured" 2>/dev/null || printf '%s' "$configured")"
  printf '   gpg-agent.conf  %s\n' "$GPG_AGENT_CONF"
  printf '   pinentry        %s\n' "${configured:-(unset)}"
  printf '   pinentry-tmux   %s\n' "$PINENTRY_TMUX"
  printf '   agent           %s\n' "$(agent_pid || printf 'unreachable')"
  printf '   GPG_TTY         %s\n' "${GPG_TTY:-(unset)}"

  if [ ! -x "$PINENTRY_TMUX" ]; then
    record_fail "pinentry-tmux not executable: $PINENTRY_TMUX"
  elif [ -z "$configured" ]; then
    record_fail "no pinentry-program in $GPG_AGENT_CONF"
  elif [ "$configured_real" != "$(readlink -f "$PINENTRY_TMUX" 2>/dev/null || printf '%s' "$PINENTRY_TMUX")" ]; then
    record_fail "pinentry-program is $configured, not $PINENTRY_TMUX"
  else
    record_pass "pinentry-program points at pinentry-tmux"
  fi

  local client
  if client="$(timeout 5 "$PINENTRY_TMUX" --check 2>/dev/null)"; then
    printf '   client          %s\n' "${client#client=}"
    record_pass "popup client resolved"
  else
    printf '   client          (none)\n'
    record_skip "no attached tmux client (run from the tmux console)"
  fi

  key="$(signing_key)"
  if [ -z "$key" ]; then
    record_skip "no signing key in git or jj config"
    return
  fi
  grip="$(keygrip_of "$key")"
  printf '   signing key     %s\n' "$key"
  printf '   keygrip         %s\n' "${grip:-(unknown)}"
  if [ -z "$grip" ]; then
    record_fail "no secret key matching '$key'"
    return
  fi
  if key_unlocked "$key"; then
    printf '   cache           unlocked\n'
  else
    printf '   cache           locked (the next signature will prompt)\n'
  fi
  record_pass "signing key and keygrip found"
}

# --- automated checks --------------------------------------------------------

# A tmux stand-in, driven by PTS_TMUX_TEST_MODE:
#   no-client  no pane, no client: pinentry-tmux must refuse at once
#   bad-popup  a client exists but display-popup fails: must time out, not hang
fake_tmux() { # fake_tmux DIR
  mkdir -p "$1"
  cat >"$1/tmux" <<'EOF'
#!/bin/sh
case "$1" in
  list-panes)   [ "$PTS_TMUX_TEST_MODE" = bad-popup ] && echo "/dev/pts/999 work"; exit 0 ;;
  list-clients) [ "$PTS_TMUX_TEST_MODE" = bad-popup ] && echo "/dev/pts/998 work"; exit 0 ;;
  display-message) echo "80 24"; exit 0 ;;
  display-popup) exit 1 ;;
  *) exit 0 ;;
esac
EOF
  chmod +x "$1/tmux"
}

now_ms() { date +%s%3N; }

run_fake_case() { # run_fake_case MODE -> sets OUT, RC, ELAPSED
  local dir start
  dir="$(mktemp -d)"
  fake_tmux "$dir"
  start="$(now_ms)"
  OUT="$(printf 'GETPIN\n' | env \
    PATH="$dir:$PATH" \
    PTS_TMUX_TEST_MODE="$1" \
    GPG_TTY=/dev/pts/999 \
    TMUX=fake,1,0 \
    PINENTRY_TMUX_TIMEOUT=1 \
    timeout 10 "$PINENTRY_TMUX" 2>&1)"
  RC=$?
  ELAPSED=$(( $(now_ms) - start ))
  rm -rf "$dir"
}

test_fallback() {
  step "no attached client"
  if [ ! -x "$PINENTRY_TMUX" ]; then
    record_skip "pinentry-tmux not executable"
    return
  fi
  run_fake_case no-client
  if [ "$RC" -eq 1 ] && printf '%s' "$OUT" | grep -q 'No pinentry' && [ "$ELAPSED" -lt 2000 ]; then
    record_pass "fails fast with \"No pinentry\" (${ELAPSED}ms)"
  else
    record_fail "expected exit 1 + No pinentry in <2s, got exit $RC in ${ELAPSED}ms"
    printf '   output: %s\n' "$(printf '%s' "$OUT" | head -2 | tr '\n' ' ')"
  fi
}

test_timeout() {
  step "popup failure"
  if [ ! -x "$PINENTRY_TMUX" ]; then
    record_skip "pinentry-tmux not executable"
    return
  fi
  run_fake_case bad-popup
  if [ "$RC" -eq 1 ] && printf '%s' "$OUT" | grep -q 'Operation cancelled' && [ "$ELAPSED" -lt 3000 ]; then
    record_pass "gives up with \"Operation cancelled\" (${ELAPSED}ms)"
  else
    record_fail "expected exit 1 + Operation cancelled in <3s, got exit $RC in ${ELAPSED}ms"
    printf '   output: %s\n' "$(printf '%s' "$OUT" | head -2 | tr '\n' ' ')"
  fi
}

# Positive relay check: a stub pinentry answers GETPIN from inside a real
# popup, so the whole FIFO/popup plumbing is exercised without a passphrase.
# A popup flashes on the attached client.
test_relay() {
  step "popup relay (stub pinentry)"
  local stub dir pane out rc
  if ! timeout 5 "$PINENTRY_TMUX" --check >/dev/null 2>&1; then
    record_skip "no attached tmux client"
    return
  fi
  pane="$(timeout 5 "$PINENTRY_TMUX" --check | sed -n 's/^client=//p')"
  dir="$(mktemp -d)"
  stub="$dir/pinentry-stub"
  cat >"$stub" <<'EOF'
#!/bin/sh
echo "OK stub ready"
while IFS= read -r line; do
  case "$line" in
    GETPIN) printf 'D doctor-relay\nOK\n' ;;
    BYE)    echo OK; exit 0 ;;
    *)      echo OK ;;
  esac
done
EOF
  chmod +x "$stub"
  printf '   a popup will flash on %s\n' "$pane"
  out="$(printf 'GETPIN\nBYE\n' | env \
    GPG_TTY="$pane" \
    PINENTRY_TMUX_PROGRAM="$stub" \
    timeout 15 "$PINENTRY_TMUX" 2>&1)"
  rc=$?
  rm -rf "$dir"
  if [ "$rc" -eq 0 ] && printf '%s' "$out" | grep -q 'doctor-relay'; then
    record_pass "popup relay round-trip"
  else
    record_fail "relay failed (exit $rc)"
    printf '   output: %s\n' "$(printf '%s' "$out" | tail -4 | tr '\n' ' ')"
  fi
}

check_leftovers() {
  step "leftovers"
  local dirs logs procs
  dirs="$(find "$TMP" -maxdepth 1 -name 'pinentry-tmux.*' 2>/dev/null | wc -l)"
  logs="$(find "$TMP" -maxdepth 1 -name 'pinentry-tmux-popup-*.log' 2>/dev/null | wc -l)"
  procs="$(pgrep -f "$PINENTRY_TMUX" 2>/dev/null | wc -l)"
  if [ "$dirs" -eq 0 ] && [ "$logs" -eq 0 ] && [ "$procs" -eq 0 ]; then
    record_pass "no FIFO directory, popup log or process left"
  else
    record_fail "leftovers: $dirs dir(s), $logs log(s), $procs process(es)"
  fi
}

# --- guided check (throwaway key) --------------------------------------------

test_sign() {
  step "guided signature (throwaway key)"
  if [ ! -t 0 ]; then
    record_skip "not an interactive session (run from the tmux console)"
    return
  fi
  if [ ! -x "$PINENTRY_TMUX" ]; then
    record_skip "pinentry-tmux not executable"
    return
  fi
  if ! command -v gpg >/dev/null 2>&1; then
    record_skip "gpg not found"
    return
  fi

  local dir old_home fpr rc
  dir="$(mktemp -d)"
  old_home="${GNUPGHOME:-}"
  export GNUPGHOME="$dir/gnupg"
  mkdir -m 700 "$GNUPGHOME"
  cat >"$GNUPGHOME/gpg-agent.conf" <<EOF
pinentry-program $PINENTRY_TMUX
allow-loopback-pinentry
default-cache-ttl 1
max-cache-ttl 1
EOF
  cleanup_sign() {
    gpgconf --kill gpg-agent >/dev/null 2>&1 || true
    if [ -n "$old_home" ]; then export GNUPGHOME="$old_home"; else unset GNUPGHOME; fi
    rm -rf "$dir"
  }
  trap cleanup_sign EXIT INT

  if ! gpg --batch --pinentry-mode loopback --passphrase "$TEST_PASSPHRASE" \
      --quick-gen-key 'GPG signing doctor <doctor@example.invalid>' default default never \
      >/dev/null 2>"$dir/keygen.err"; then
    record_fail "could not create the throwaway key"
    printf '   %s\n' "$(head -1 "$dir/keygen.err")"
    cleanup_sign
    trap - EXIT INT
    return
  fi
  fpr="$(gpg --with-colons --list-keys 'doctor@example.invalid' 2>/dev/null \
    | awk -F: '$1 == "fpr" { print $10; exit }')"
  # Start a fresh agent for the throwaway homedir: it must read the
  # pinentry-program above, and must not keep the keygen passphrase cached.
  gpgconf --kill gpg-agent >/dev/null 2>&1 || true
  printf '   throwaway key  %s\n' "$fpr"
  printf '   in the popup, type: %s%s%s\n' "$C_OK" "$TEST_PASSPHRASE" "$C_OFF"

  if ! ask "Open the popup and sign with the throwaway key?"; then
    record_skip "guided signature declined"
    cleanup_sign
    trap - EXIT INT
    return
  fi

  printf 'gpg-signing-doctor\n' \
    | timeout 120 gpg --pinentry-mode default --clearsign -u "$fpr" \
      >"$dir/signed" 2>"$dir/sign.err"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    record_fail "gpg failed (exit $rc)"
    printf '   %s\n' "$(head -1 "$dir/sign.err")"
  elif ! gpg --verify "$dir/signed" >/dev/null 2>&1; then
    record_fail "signature produced but not verifiable"
  else
    record_pass "signature produced and verified"
    if ask "Did the popup appear and accept the passphrase?"; then
      record_pass "popup perceived"
    else
      record_fail "signature produced but popup not perceived"
    fi
  fi

  cleanup_sign
  trap - EXIT INT
}

main() {
  printf '%s - GPG signing check\n' "$PROG"

  if want config; then test_inventory; fi
  if want fallback; then test_fallback; fi
  if want timeout; then test_timeout; fi
  if want relay; then test_relay; fi
  if [ -z "$ONLY" ]; then
    check_leftovers
  fi
  if want sign; then test_sign; fi

  step "summary"
  printf '   %d ok, %d failed, %d skipped\n' "$pass" "$fail" "$skip"
  if (( fail )); then
    printf '   %sfailed%s\n' "$C_FAIL" "$C_OFF"
    exit 1
  fi
  printf '   %sall good%s\n' "$C_OK" "$C_OFF"
  exit 0
}

while (( $# )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --key) KEY="${2:?--key requires a value}"; shift 2 ;;
    --key=*) KEY="${1#*=}"; shift ;;
    --only-config) ONLY=config; shift ;;
    --only-fallback) ONLY=fallback; shift ;;
    --only-timeout) ONLY=timeout; shift ;;
    --only-relay) ONLY=relay; shift ;;
    --only-sign) ONLY=sign; shift ;;
    *) die "unknown option '$1'" ;;
  esac
done

main "$@"
