{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "default_agent": "chat",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "/workspace/examples/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.corrections/", "effect": "allow" }
  ],
  // I use `mise exec --cd / -- ...` to launch MCP servers with the Node instance installed globally by Mise.
  // `codemode: false` keeps the MCP tools directly callable, as in OpenCode 1 (the subagents and skills call them by name).
  "mcp": {
    "servers": {
      "mise": {
        "type": "local",
        "command": ["mise", "mcp"],
        "disabled": true,
        "codemode": false
      },
      "pitchfork": {
        "type": "local",
        "command": ["pitchfork", "mcp"],
        "disabled": true,
        "codemode": false
      },
      "fetch": {
        "type": "local",
        "command": ["mise", "exec", "--cd", "/", "--", "mcp-server-fetch"],
        "codemode": false,
        "environment": {
          "DEFAULT_LIMIT": "0"
        }
      },
      "context7": {
        "type": "local",
        "command": ["mise", "exec", "--cd", "/", "--", "context7-mcp", "--api-key", "{{ secret(name="CONTEXT7_APIKEY") }}"],
        "disabled": true,
        "codemode": false
      },
      "tavily": {
        "type": "local",
        "command": ["mise", "exec", "--cd", "/", "--", "tavily-mcp"],
        "disabled": true,
        "codemode": false,
        "environment": {
          "TAVILY_API_KEY": "{{ secret(name="TAVILY_APIKEY") }}",
          "DEFAULT_PARAMETERS": "{\"include_images\": false, \"max_results\": 15, \"search_depth\": \"advanced\"}"
        }
      },
      "exa": {
        "type": "local",
        "command": ["mise", "exec", "--cd", "/", "--", "exa-mcp-server"],
        "disabled": true,
        "codemode": false,
        "environment": {
          "EXA_API_KEY": "{{ secret(name="EXA_IA_OPENCODE_DEVBOX_APIKEY") }}"
        }
      },
      // Commented out on 2026-10-30: broken, so it never contributes anything.
      // The audit reports it as failed and it would fail the same way in a
      // normal session. Uncomment once the chain is served correctly.
      // "hindsight": {
      //   "type": "remote",
      //   "url": "https://api.hindsight.sklein.internal/mcp/",
      //   "oauth": false,
      //   "disabled": true,
      //   "codemode": false,
      //   "headers": {
      //     "Authorization": "Bearer <HINDSIGHT_MCP_TOKEN>"
      //   }
      // },
      "playwright": {
        "type": "local",
        "command": ["mise", "exec", "--cd", "/", "--", "playwright-mcp", "--no-sandbox"],
        "disabled": true,
        "codemode": false,
        "environment": {
          "PLAYWRIGHT_MCP_CDP_ENDPOINT": "http://127.0.0.1:9222"
        }
      },
      // Commented out on 2026-10-30: the module path does not exist on this
      // instance, so the server dies at startup. Uncomment after installing it.
      // "browser-control": {
      //   "type": "local",
      //   "command": ["node", "{{ env.HOME }}/.local/share/browser-control-mcp/mcp-server/dist/server.js"],
      //   "disabled": true,
      //   "codemode": false,
      //   "environment": {
      //     "EXTENSION_SECRET": "<BROWSER_CONTROL_MCP_EXTENSION_SECRET>",
      //     "EXTENSION_PORT": "8090"
      //   }
      // },
      "toggl-pg-mirror-readonly": {
        "type": "remote",
        "url": "https://memex.sklein.xyz/mcp/readonly",
        "oauth": false,
        "disabled": true,
        "codemode": false,
        "headers": {
          "Authorization": "Bearer {{ secret(name="MEMEX_SKLEIN_XYZ_MCP_READER_OPENCODE_TOKEN") }}"
        }
      }
    }
  },
  // OpenCode 2: one entry loads both the server and the TUI parts of a plugin.
  "plugins": [
    "@slkiser/opencode-quota@5.0.3",
    "cc-safety-net@2.6.19",
  ],
  // Todos are off by default in OpenCode 2.
  "experimental": {
    "todo": true
  }
}
