#!/usr/bin/env bash
# import-opencode-credentials - this script injects the credentials found in
# ~/.local/share/opencode/credentials.json into the OpenCode SQLite database.

set -euo pipefail

[ -f "$HOME/.local/share/opencode/credentials.json" ] || exit 0

# The active opencode-go account is kept in prev_label so it can be restored at
# the end.
prev_label=$(opencode api get /api/credential 2>/dev/null |
  jq -r '.data[]? | select(.integrationID=="opencode-go" and .active) | .label' |
  head -1 || true)

# Log out of every opencode-go account so they can be imported again below.
for label in $(jq -r '.[] | select(.integrationID=="opencode-go") | .label' \
  "$HOME/.local/share/opencode/credentials.json"); do
  opencode auth logout opencode-go "$label" >/dev/null 2>&1 || true
done

opencode auth import --standalone \
  "$HOME/.local/share/opencode/credentials.json" >/dev/null 2>&1 || true

# Restore the previous choice, or the seed's default on a fresh instance.
opencode auth switch opencode-go "${prev_label:-$(
  jq -r '.[] | select(.integrationID=="opencode-go" and .active) | .label' \
    "$HOME/.local/share/opencode/credentials.json")}" >/dev/null 2>&1 || true
