#!/usr/bin/env bash
# sklein-devbox-ingress - wildcard DNS + TLS reverse proxy for the
# sklein-devbox instance, exposed to the NetBird network.
#
# It wires two pieces together:
#
#   1. a NetBird Custom DNS Zone for the host FQDN (<tld>) holding a wildcard
#      A record *.<tld> -> the wt0 (overlay) address, distributed to every
#      peer;
#   2. the pitchfork reverse proxy (settings.proxy in
#      ~/.config/pitchfork/config.toml), routing <daemon>.<project>.<tld> plus
#      any extra label on the left, and signing a per-hostname certificate with
#      its local CA.
#
# Why a zone and not a nameserver: <tld> is the host FQDN, which lives inside
# the NetBird peer DNS domain (Settings > Network > DNS Domain). NetBird's
# client resolver is authoritative for that whole domain: it answers peer names
# and returns NXDOMAIN (with the `aa` flag) for anything else, without ever
# forwarding to a nameserver. A nameserver group with `match domain = <tld>` is
# therefore dead config. Records of a Custom DNS Zone are injected into that
# authoritative answer instead, which is the only supported way to add names
# under the peer DNS domain.
#
# Limitation: a wildcard record matches ONE label level, so <slug>.<tld>
# resolves (global daemons, [slugs]) but <daemon>.<project>.<tld> and
# extra.<slug>.<tld> do not.
#
# <tld> is the host's own FQDN (`hostname -f`), the same value the pitchfork
# proxy uses for settings.proxy.tld in ~/.config/pitchfork/config.toml.
#
# Everything runs as the `devbox` user; the only privileged step is
# `pitchfork proxy setup` (bind capability for :443 and CA trust).
#
# See sklein-devbox-mise-config/README.md.

set -u -o pipefail

PROG="${0##*/}"

TLD="$(hostname -f 2>/dev/null || true)"
NETBIRD_API="https://api.netbird.io/api"
# Zone name is only a label; key it to the instance so that two ingress hosts
# do not create homonymous zones in the same account.
ZONE_NAME="${TLD%%.*}"
# Nameserver group created by earlier versions of this script. It never worked
# (see the header) and is only kept so `down --purge` can clean it up.
LEGACY_NS_NAME="sklein-devbox-ingress"

PURGE=0
PAT=""

if [ -t 1 ]; then
  C_DIM=$'\033[2m'; C_OK=$'\033[32m'; C_OFF=$'\033[0m'
else
  C_DIM=; C_OK=; C_OFF=
fi

usage() {
  cat <<EOF
$PROG - wildcard DNS + TLS proxy for sklein-devbox over NetBird.

Serves *.$TLD (one label level) to NetBird peers through a NetBird Custom DNS
Zone, and fronts the pitchfork daemons with a local-CA TLS proxy.

Usage:
  $PROG up        Ensure the DNS zone + wildcard record and the pitchfork proxy
  $PROG down      Remove the wildcard record (peers stop resolving the ingress)
  $PROG status    Show proxy, zone, record and resolution state
  $PROG -h|--help Show this help

\`down\` options:
  --purge         Also delete the NetBird zone and the legacy nameserver group

Environment:
  NETBIRD_PAT     NetBird personal access token. Read from gopass
                  (netbird/apikey) when unset.
EOF
}

die() { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 2; }
# info/ok write to stderr: they are logs, and several helpers below return their
# value on stdout through command substitution.
info() { printf '%s==%s %s\n' "$C_DIM" "$C_OFF" "$*" >&2; }
ok() { printf '   %sok%s %s\n' "$C_OK" "$C_OFF" "$*" >&2; }

case "$TLD" in
  *.*) ;;
  *) die "cannot determine the host FQDN (hostname -f returned '${TLD:-<empty>}')" ;;
esac

need() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

wt0_ip() {
  /usr/sbin/ip -4 -o addr show wt0 2>/dev/null \
    | awk 'NR==1{split($4, a, "/"); print a[1]}'
}

netbird_pat() {
  if [ -n "${NETBIRD_PAT:-}" ]; then
    printf '%s' "$NETBIRD_PAT"
    return
  fi
  command -v gopass >/dev/null 2>&1 || die "NETBIRD_PAT unset and gopass not found"
  gopass show -o netbird/apikey 2>/dev/null \
    || die "cannot read NETBIRD_PAT (gopass 'netbird/apikey')"
}

api() { # api METHOD PATH [JSON_BODY]
  local method="$1" path="$2" body="${3:-}"
  if [ -n "$body" ]; then
    curl -fsS -X "$method" \
      -H "Authorization: Token ${PAT}" \
      -H 'Accept: application/json' \
      -H 'Content-Type: application/json' \
      --data "$body" "${NETBIRD_API}${path}"
  else
    curl -fsS -X "$method" \
      -H "Authorization: Token ${PAT}" \
      -H 'Accept: application/json' \
      "${NETBIRD_API}${path}"
  fi
}

all_group_id() {
  api GET /groups | jq -r '[.[] | select(.name == "All")][0].id // empty'
}

# ---------------------------------------------------------------------------
# NetBird DNS (Custom DNS Zone + wildcard record)
# ---------------------------------------------------------------------------

zone_id() {
  api GET /dns/zones \
    | jq -r --arg d "$TLD" '[.[] | select(.domain == $d)][0].id // empty'
}

legacy_nameserver_id() {
  api GET /dns/nameservers \
    | jq -r --arg n "$LEGACY_NS_NAME" '[.[] | select(.name == $n)][0].id // empty'
}

zone_body() { # zone_body ALL_ID
  jq -nc --arg n "$ZONE_NAME" --arg d "$TLD" --arg g "$1" \
    '{name: $n, domain: $d, enabled: true,
      enable_search_domain: false, distribution_groups: [$g]}'
}

ensure_zone() { # ensure_zone ALL_ID -> zone id on stdout
  local all_id="$1" zid cur body
  body="$(zone_body "$all_id")"
  zid="$(zone_id)"
  if [ -z "$zid" ]; then
    info "creating NetBird DNS zone $ZONE_NAME ($TLD)"
    zid="$(api POST /dns/zones "$body" | jq -r '.id // empty')" \
      || die "could not create DNS zone $TLD"
    [ -n "$zid" ] || die "could not create DNS zone $TLD"
    ok "zone $zid created"
  else
    cur="$(api GET "/dns/zones/${zid}" | jq -r '.name')"
    if [ "$cur" != "$ZONE_NAME" ]; then
      info "renaming NetBird DNS zone '$cur' to '$ZONE_NAME'"
      api PUT "/dns/zones/${zid}" "$body" >/dev/null \
        || info "could not rename the zone (its name is only a label; harmless)"
    fi
    ok "zone $zid (existing)"
  fi
  printf '%s' "$zid"
}

ensure_record() { # ensure_record ZONE_ID IP
  local zid="$1" ip="$2" name="*.${TLD}" rid cur body
  body="$(jq -nc --arg n "$name" --arg ip "$ip" \
    '{name: $n, type: "A", content: $ip, ttl: 300}')"
  rid="$(api GET "/dns/zones/${zid}/records" \
    | jq -r --arg n "$name" '[.[] | select(.name == $n)][0].id // empty')"
  if [ -z "$rid" ]; then
    api POST "/dns/zones/${zid}/records" "$body" >/dev/null \
      || die "could not create the DNS record $name -> $ip"
    ok "record $name -> $ip (created)"
    return
  fi
  cur="$(api GET "/dns/zones/${zid}/records/${rid}" | jq -r '.content')"
  if [ "$cur" = "$ip" ]; then
    ok "record $name -> $ip (unchanged)"
    return
  fi
  api PUT "/dns/zones/${zid}/records/${rid}" "$body" >/dev/null \
    || die "could not update the DNS record $name -> $ip"
  ok "record $name -> $ip (updated from $cur)"
}

remove_record() {
  local zid rid
  zid="$(zone_id)"
  if [ -z "$zid" ]; then
    info "no NetBird zone for $TLD"
    return 0
  fi
  rid="$(api GET "/dns/zones/${zid}/records" \
    | jq -r --arg n "*.${TLD}" '[.[] | select(.name == $n)][0].id // empty')"
  if [ -z "$rid" ]; then
    info "no wildcard record for *.$TLD"
    return 0
  fi
  api DELETE "/dns/zones/${zid}/records/${rid}" >/dev/null \
    || die "could not delete the wildcard record *.$TLD"
  ok "wildcard record *.$TLD deleted (peers stop resolving the ingress)"
}

purge_netbird() {
  local zid nid
  nid="$(legacy_nameserver_id)"
  if [ -n "$nid" ]; then
    api DELETE "/dns/nameservers/${nid}" >/dev/null \
      && ok "deleted legacy NetBird nameserver group '$LEGACY_NS_NAME'"
  fi
  zid="$(zone_id)"
  if [ -n "$zid" ]; then
    api DELETE "/dns/zones/${zid}" >/dev/null \
      && ok "deleted NetBird zone $TLD"
  fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_up() {
  need pitchfork; need curl; need jq

  local ip
  ip="$(wt0_ip)"
  [ -n "$ip" ] || die "wt0 has no IPv4 address (is netbird up?)"
  info "wt0 address: $ip"

  # The supervisor hands its environment to every daemon it spawns. A foreign
  # XDG_RUNTIME_DIR (seen: /tmp, leaked from the foot host's ssh client) makes
  # rootless podman resolve its runroot under /tmp and netavark fail to create
  # /run/user/<uid>/containers/networks/aardvark-dns, breaking `podman compose up`.
  # A foreign DBUS_SESSION_BUS_ADDRESS (/tmp/foot-host-bus) breaks podman's
  # systemd sandbox cgroup. Pin a sane environment before (re)starting it.
  if [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  else
    unset XDG_RUNTIME_DIR
  fi
  unset DBUS_SESSION_BUS_ADDRESS

  # `supervisor start --force` restarts every daemon it supervises (the OpenCode
  # server and OpenChamber included), so only reload when it is actually needed:
  #   - the supervisor is not running;
  #   - it still knows the dnsmasq daemon of earlier versions, which means it
  #     runs the previous config (no `boot_start` on the OpenCode daemons);
  #   - the running proxy uses another TLD than the rendered config.
  local legacy_daemon="global/${LEGACY_NS_NAME}-dns" running_tld="" need_restart=0
  if ! pitchfork supervisor status >/dev/null 2>&1; then
    info "starting the pitchfork supervisor"
    pitchfork supervisor start
  else
    pitchfork status "$legacy_daemon" >/dev/null 2>&1 && need_restart=1
    running_tld="$(pitchfork proxy status 2>/dev/null \
      | awk -F'TLD:[[:space:]]*' '/TLD:/{print $2; exit}')"
    [ "$running_tld" = "$TLD" ] || need_restart=1
    if [ "$need_restart" -eq 1 ]; then
      info "reloading the pitchfork supervisor (TLD '${running_tld:-?}' -> '$TLD', current config)"
      info "(supervised daemons restart; boot_start ones come back on their own)"
      pitchfork supervisor start --force
    else
      info "pitchfork supervisor running with TLD $TLD (no restart)"
    fi
  fi

  info "configuring the pitchfork proxy system bits (bind :443, trust CA; sudo)"
  pitchfork proxy setup

  pitchfork proxy doctor || true

  PAT="$(netbird_pat)"
  local all_id zid
  all_id="$(all_group_id)"
  [ -n "$all_id" ] || die "could not find the NetBird 'All' group"

  info "configuring NetBird DNS (zone + wildcard record -> $ip)"
  zid="$(ensure_zone "$all_id")"
  ensure_record "$zid" "$ip"

  # Earlier versions also created a nameserver group pointing at dnsmasq:5353.
  # NetBird never consults it (see the header), no DNS daemon runs anymore, so
  # drop it instead of leaving dead config behind.
  local nid
  nid="$(legacy_nameserver_id)"
  if [ -n "$nid" ]; then
    api DELETE "/dns/nameservers/${nid}" >/dev/null \
      && ok "deleted the legacy NetBird nameserver group ($LEGACY_NS_NAME)"
  fi

  cat <<EOF

Ingress is up:  *.$TLD  ->  $ip
  (one label level: <slug>.$TLD; <daemon>.<project>.<tld> does not resolve)

  - trust the proxy CA on every client:
      ~/.local/state/pitchfork/proxy/ca.pem
    then, on a client with pitchfork: pitchfork proxy trust --cert <copied-ca.pem>
  - a connected NetBird peer picks the zone up on its next network map update;
    if a name still does not resolve, resync the client: netbird down && netbird up
EOF
}

cmd_down() {
  need curl; need jq

  PAT="$(netbird_pat)"
  if [ "$PURGE" -eq 1 ]; then
    purge_netbird
  else
    remove_record
  fi

  info "the pitchfork proxy itself keeps running (pitchfork supervisor stop to stop it)"
}

cmd_status() {
  need curl; need jq

  local ip zid rec
  ip="$(wt0_ip)"
  info "wt0 address: ${ip:-<none>}"

  info "pitchfork proxy"
  pitchfork proxy status 2>&1 || true
  pitchfork proxy doctor 2>&1 || true

  PAT="$(netbird_pat)"
  info "NetBird DNS zone"
  zid="$(zone_id)"
  if [ -z "$zid" ]; then
    printf '   no zone for %s - run: %s up\n' "$TLD" "$PROG"
  else
    api GET "/dns/zones/${zid}" \
      | jq -r '"   zone:    " + .name + " (" + .id + ", enabled=" + (.enabled | tostring) + ")"' \
      || true
    rec="$(api GET "/dns/zones/${zid}/records" \
      | jq -r --arg n "*.${TLD}" \
          '.[] | select(.name == $n)
               | .name + " -> " + .content + " (ttl " + (.ttl | tostring) + ")"')"
    if [ -n "$rec" ]; then
      printf '   record:  %s\n' "$rec"
    else
      printf '   record:  *.%s MISSING - run: %s up\n' "$TLD" "$PROG"
    fi
  fi

  # Ask this peer's own NetBird resolver: it answers the zone records exactly as
  # it does on every other peer. Unlike this, 127.0.0.1:15353 (pitchfork's local
  # stub) and a local getent always answer 127.0.0.1 on the ingress host itself.
  info "NetBird local resolver (@${ip:-none}:53)"
  if [ -z "$ip" ] || ! command -v dig >/dev/null 2>&1; then
    printf '   (needs a wt0 address and dig, from bind-utils)\n'
  else
    printf '   test.<tld>      -> %s\n' \
      "$(dig +short +time=2 +tries=1 "@${ip}" "test.${TLD}" A 2>/dev/null | tr '\n' ' ')"
    printf '   a.b.test.<tld>  -> %s (one label level only)\n' \
      "$(dig +short +time=2 +tries=1 "@${ip}" "a.b.test.${TLD}" A 2>/dev/null | tr '\n' ' ')"
  fi
}

while (( $# )); do
  case "$1" in
    up|down|status) CMD="$1"; shift ;;
    --purge) PURGE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument '$1'" ;;
  esac
done

case "${CMD:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  *) usage; exit 2 ;;
esac
