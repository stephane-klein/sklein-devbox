#!/usr/bin/env bash
# sklein-devbox-ingress - wildcard DNS + TLS reverse proxy for the
# sklein-devbox instance, exposed to the NetBird network.
#
# It wires two pieces together:
#
#   1. dnsmasq (a pitchfork daemon, unprivileged, wt0:5353) answering
#      *.<tld> - at any depth - with the wt0 (overlay) address, plus the
#      NetBird nameserver group that routes <tld> to it on every peer;
#   2. the pitchfork reverse proxy (settings.proxy in
#      ~/.config/pitchfork/config.toml), routing <daemon>.<project>.<tld> plus
#      any extra label on the left, and signing a per-hostname certificate with
#      its local CA.
#
# Why <tld> is not the host FQDN: the NetBird client resolver is authoritative
# over the peer DNS domain (Settings > Network > DNS Domain, here
# homelab.stephane-klein.info) and never forwards a name below it to a
# nameserver. A nameserver group is only consulted for a domain OUTSIDE that
# peer domain, so the ingress namespace lives under its own domain:
#
#     <instance>.devbox.sklein.xyz   (INGRESS_DOMAIN below)
#
# dnsmasq --address= then matches that domain and all its subdomains, at any
# depth, which is what allows <daemon>.<project>.<instance>.devbox.sklein.xyz.
#
# The namespace is deliberately not published: sklein.xyz has no record under
# devbox.*, so a client outside NetBird gets NXDOMAIN. That is split DNS by
# design; do not publish a wildcard record there.
#
# <tld> is <instance>.<INGRESS_DOMAIN>, the same value the pitchfork proxy
# renders for settings.proxy.tld in ~/.config/pitchfork/config.toml.
#
# Everything runs as the `devbox` user; the only privileged step is
# `pitchfork proxy setup` (bind capability for :443 and CA trust).
#
# See sklein-devbox-mise-config/README.md.

set -u -o pipefail

PROG="${0##*/}"

INSTANCE="$(hostname -s 2>/dev/null || true)"
# Must match the `ingress_domain` literal in
# dotfiles/dot-config/pitchfork/config.toml.tera.
INGRESS_DOMAIN="devbox.sklein.xyz"
TLD="${INSTANCE}.${INGRESS_DOMAIN}"

DNS_PORT=5353
NETBIRD_API="https://api.netbird.io/api"
# One nameserver group per instance: two ingress hosts must not share a domain.
NS_NAME="ingress-${INSTANCE}"
DNS_DAEMON="global/sklein-devbox-ingress-dns"

PAT=""

if [ -t 1 ]; then
  C_DIM=$'\033[2m'; C_OK=$'\033[32m'; C_OFF=$'\033[0m'
else
  C_DIM=; C_OK=; C_OFF=
fi

usage() {
  cat <<EOF
$PROG - wildcard DNS + TLS proxy for sklein-devbox over NetBird.

Serves *.$TLD (any depth) to NetBird peers through a dnsmasq daemon and a
NetBird nameserver group, and fronts the pitchfork daemons with a local-CA TLS
proxy.

Usage:
  $PROG up        Ensure the DNS daemon, the nameserver group and the proxy
  $PROG down      Delete the nameserver group (peers stop resolving the ingress)
  $PROG status    Show proxy, daemon, group and resolution state
  $PROG -h|--help Show this help

Environment:
  NETBIRD_PAT     NetBird personal access token. Read from gopass
                  (netbird/apikey) when unset.
EOF
}

die() { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 2; }
# info/ok write to stderr: they are logs, and several helpers below return their
# value on stdout through command substitution.
info() { printf '%s==%s %s\n' "$C_DIM" "$C_OFF" "$*" >&2; }
ok() { printf '   %sok%s %s\n' "$C_OK" "$C_OFF" "$*" >&2; }

case "$INSTANCE" in
  "" | *.* | *[!a-z0-9-]*)
    die "cannot determine the instance name (hostname -s returned '${INSTANCE:-<empty>}')"
    ;;
esac

need() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

wt0_ip() {
  /usr/sbin/ip -4 -o addr show wt0 2>/dev/null \
    | awk 'NR==1{split($4, a, "/"); print a[1]}'
}

dnsq() { # dnsq SERVER NAME -> first address, or "(no answer)"
  local out
  # `dig +short` may print several lines, and prints lookup failures (starting
  # with ";;") on stdout: keep the first address and treat those as no answer.
  out="$(dig +short +time=2 +tries=1 "@${1}" -p "${DNS_PORT}" "${2}" A 2>/dev/null \
    | awk 'NR==1 && $1 !~ /^;/ {print $1}')"
  if [ -n "$out" ]; then printf '%s' "$out"; else printf '(no answer)'; fi
}

netbird_pat() {
  if [ -n "${NETBIRD_PAT:-}" ]; then
    printf '%s' "$NETBIRD_PAT"
    return
  fi
  command -v gopass >/dev/null 2>&1 || die "NETBIRD_PAT unset and gopass not found"
  gopass show -o netbird/apikey 2>/dev/null \
    || die "cannot read NETBIRD_PAT (gopass 'netbird/apikey')"
}

api() { # api METHOD PATH [JSON_BODY]
  local method="$1" path="$2" body="${3:-}"
  if [ -n "$body" ]; then
    curl -fsS -X "$method" \
      -H "Authorization: Token ${PAT}" \
      -H 'Accept: application/json' \
      -H 'Content-Type: application/json' \
      --data "$body" "${NETBIRD_API}${path}"
  else
    curl -fsS -X "$method" \
      -H "Authorization: Token ${PAT}" \
      -H 'Accept: application/json' \
      "${NETBIRD_API}${path}"
  fi
}

all_group_id() {
  api GET /groups | jq -r '[.[] | select(.name == "All")][0].id // empty'
}

# ---------------------------------------------------------------------------
# NetBird DNS (nameserver group -> dnsmasq on the overlay)
# ---------------------------------------------------------------------------

nameserver_id() {
  api GET /dns/nameservers \
    | jq -r --arg n "$NS_NAME" '[.[] | select(.name == $n)][0].id // empty'
}

nameserver_body() { # nameserver_body ALL_ID IP
  jq -nc --arg n "$NS_NAME" --arg d "$TLD" --arg ip "$2" --arg g "$1" \
    --argjson port "$DNS_PORT" \
    '{name: $n, description: ("wildcard *." + $d), primary: false, enabled: true,
      nameservers: [{ip: $ip, ns_type: "udp", port: $port}],
      domains: [$d], groups: [$g], search_domains_enabled: false}'
}

ensure_nameserver() { # ensure_nameserver ALL_ID IP
  local all_id="$1" ip="$2" nid body
  body="$(nameserver_body "$all_id" "$ip")"
  nid="$(nameserver_id)"
  if [ -z "$nid" ]; then
    info "creating the NetBird nameserver group $NS_NAME ($TLD -> $ip:$DNS_PORT)"
    api POST /dns/nameservers "$body" >/dev/null \
      || die "could not create the NetBird nameserver group $NS_NAME"
    ok "nameserver group created"
    return
  fi
  api PUT "/dns/nameservers/${nid}" "$body" >/dev/null \
    || die "could not update the NetBird nameserver group $NS_NAME"
  ok "nameserver group $nid (updated)"
}

remove_nameserver() {
  local nid
  nid="$(nameserver_id)"
  if [ -z "$nid" ]; then
    info "no NetBird nameserver group '$NS_NAME' for $TLD"
    return 0
  fi
  api DELETE "/dns/nameservers/${nid}" >/dev/null \
    || die "could not delete the NetBird nameserver group '$NS_NAME'"
  ok "nameserver group '$NS_NAME' deleted (peers stop resolving $TLD)"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_up() {
  need pitchfork; need dnsmasq; need curl; need jq

  local ip
  ip="$(wt0_ip)"
  [ -n "$ip" ] || die "wt0 has no IPv4 address (is netbird up?)"
  info "wt0 address: $ip"
  info "ingress TLD: $TLD"

  # The supervisor hands its environment to every daemon it spawns. A foreign
  # XDG_RUNTIME_DIR (seen: /tmp, leaked from the foot host's ssh client) makes
  # rootless podman resolve its runroot under /tmp and netavark fail to create
  # /run/user/<uid>/containers/networks/aardvark-dns, breaking `podman compose up`.
  # A foreign DBUS_SESSION_BUS_ADDRESS (/tmp/foot-host-bus) breaks podman's
  # systemd sandbox cgroup. Pin a sane environment before (re)starting it.
  if [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  else
    unset XDG_RUNTIME_DIR
  fi
  unset DBUS_SESSION_BUS_ADDRESS

  # `supervisor start --force` restarts every daemon it supervises (the OpenCode
  # server and OpenChamber included), so only reload when it is actually needed:
  # the supervisor is not running, or the rendered config is newer than the
  # running supervisor. `pitchfork proxy status` reads the config FILE, not the
  # running proxy, so it cannot tell whether a reload is pending: the supervisor
  # reads settings.proxy.tld once, at start, and keeps serving it.
  local config_path="$HOME/.config/pitchfork/config.toml" sup_pid=""
  if ! pitchfork supervisor status >/dev/null 2>&1; then
    info "starting the pitchfork supervisor"
    pitchfork supervisor start
  else
    sup_pid="$(pgrep -f 'pitchfork supervisor run$' | head -1 || true)"
    if [ -n "$sup_pid" ] && [ "$config_path" -nt "/proc/${sup_pid}" ]; then
      info "reloading the pitchfork supervisor (config newer than the running daemon)"
      info "(supervised daemons restart; boot_start ones come back on their own)"
      pitchfork supervisor start --force
    else
      info "pitchfork supervisor up to date (no restart)"
    fi
  fi

  info "configuring the pitchfork proxy system bits (bind :443, trust CA; sudo)"
  pitchfork proxy setup

  pitchfork proxy doctor || true

  info "starting the DNS daemon ($DNS_DAEMON)"
  if ! pitchfork status "$DNS_DAEMON" 2>/dev/null | grep -qi running; then
    pitchfork start "$DNS_DAEMON" \
      || die "DNS daemon did not start (see: pitchfork logs $DNS_DAEMON)"
  fi
  pitchfork status "$DNS_DAEMON" 2>/dev/null | grep -qi running \
    || die "DNS daemon is not running (see: pitchfork logs $DNS_DAEMON)"
  ok "dnsmasq running on ${ip}:${DNS_PORT}"

  if command -v dig >/dev/null 2>&1; then
    local probe="" i
    for i in 1 2 3 4 5; do
      probe="$(dnsq "$ip" "a.b.${TLD}")"
      [ "$probe" = "$ip" ] && break
      sleep 0.5
    done
    [ "$probe" = "$ip" ] \
      || die "dnsmasq does not answer a.b.$TLD (got '${probe:-nothing}')"
    ok "dnsmasq answers at any depth (a.b.$TLD -> $ip)"
  fi

  PAT="$(netbird_pat)"
  local all_id
  all_id="$(all_group_id)"
  [ -n "$all_id" ] || die "could not find the NetBird 'All' group"

  info "configuring NetBird DNS (nameserver group $NS_NAME -> $ip:$DNS_PORT)"
  ensure_nameserver "$all_id" "$ip"

  cat <<EOF

Ingress is up:  *.$TLD  ->  $ip  (any depth)

  - trust the proxy CA on every client:
      ~/.local/state/pitchfork/proxy/ca.pem
    then, on a client with pitchfork: pitchfork proxy trust --cert <copied-ca.pem>
  - peers pick the nameserver group up on their next network map update; if a
    name still does not resolve, resync the client: netbird down && netbird up
  - $TLD is not published, so an outside client gets NXDOMAIN. After a lookup
    failed before the group was installed, clear the negative cache:
    resolvectl flush-caches
EOF
}

cmd_down() {
  need curl; need jq

  PAT="$(netbird_pat)"
  remove_nameserver

  info "the DNS daemon and the pitchfork proxy keep running (pitchfork supervisor stop to stop them)"
}

cmd_status() {
  need curl; need jq

  local ip nid
  ip="$(wt0_ip)"
  info "wt0 address: ${ip:-<none>}"
  info "ingress TLD: $TLD (instance $INSTANCE, domain $INGRESS_DOMAIN)"

  info "pitchfork proxy"
  pitchfork proxy status 2>&1 || true
  pitchfork proxy doctor 2>&1 || true

  info "DNS daemon"
  if pitchfork status "$DNS_DAEMON" >/dev/null 2>&1; then
    pitchfork status "$DNS_DAEMON" 2>&1 | sed 's/^/   /'
  else
    printf '   %s not found (run: %s up)\n' "$DNS_DAEMON" "$PROG"
  fi

  info "dnsmasq (@${ip:-none}:${DNS_PORT}, queried directly)"
  if [ -z "$ip" ] || ! command -v dig >/dev/null 2>&1; then
    printf '   (needs a wt0 address and dig, from bind-utils)\n'
  else
    printf '   a.b.<tld>      -> %s\n' "$(dnsq "$ip" "a.b.${TLD}")"
    printf '   a.b.c.d.<tld>  -> %s\n' "$(dnsq "$ip" "a.b.c.d.${TLD}")"
  fi

  PAT="$(netbird_pat)"
  info "NetBird nameserver group"
  nid="$(nameserver_id)"
  if [ -z "$nid" ]; then
    printf '   none for %s - run: %s up\n' "$TLD" "$PROG"
  else
    api GET "/dns/nameservers/${nid}" \
      | jq -r '"   name:    " + .name + " (" + .id + ", enabled=" + (.enabled | tostring) + ")",
               "   domains: " + (.domains | join(",")),
               "   server:  " + (.nameservers | map(.ip + ":" + (.port | tostring)) | join(","))' \
      || true
  fi

  info "notes"
  printf '   local getent/dig go through pitchfork'"'"'s stub (127.0.0.1:15353) and\n'
  printf '   answer 127.0.0.1 here; check end-to-end from another peer:\n'
  printf '     resolvectl query a.b.%s\n' "$TLD"
}

while (( $# )); do
  case "$1" in
    up|down|status) CMD="$1"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument '$1'" ;;
  esac
done

case "${CMD:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  *) usage; exit 2 ;;
esac
