#- The proxy TLD is the instance namespace, not the host FQDN: each instance
#   exposes <daemon>.<project>.<instance>.<ingress_domain>. It must stay
#   OUTSIDE the NetBird peer DNS domain (homelab.stephane-klein.info): NetBird
#   is authoritative over that domain and never forwards a name below it to a
#   nameserver, so the wildcard DNS relies on a nameserver group, which is only
#   consulted for a foreign domain. `~/bin/sklein-devbox-ingress` computes the
#   same value from `hostname -s` and the same `ingress_domain` literal.
{%- set instance = exec(command="hostname -s") -%}
{%- set ingress_domain = "devbox.sklein.xyz" -%}
{%- set tld = instance ~ "." ~ ingress_domain %}
{%- if "." in instance or instance == "" %}{{ throw(message="pitchfork config.toml: `hostname -s` did not return a single label") }}{% endif %}
{%- set home = exec(command="echo $HOME") -%}
{%- set mise_bin = home ~ "/.local/bin/mise" %}

[settings.web]
auto_start = true
bind_port = 3120
bind_address = "127.0.0.1"

# Boot registration, written by `pitchfork boot enable`. The path must be
# absolute: pitchfork expands neither `~` nor `$HOME`, and systemd starts the
# unit without a shell. mise maintains the `latest` symlink across upgrades, so
# the registration keeps pointing at a valid binary.
[settings.boot]
executable = "{{ home }}/.local/share/mise/installs/pitchfork/latest/pitchfork"

[daemons.chromium-headless]
run = """
chromium-browser --headless=new  --remote-debugging-port=9222  --remote-debugging-address=0.0.0.0  --remote-allow-origins="*"  --no-sandbox --window-size=1920,1200 --use-gl=angle --use-angle=swiftshader
"""
retry = true

[daemons.opencode-port-free]
# OpenChamber launches its OpenCode child with `OPENCODE_PORT=4096`, but
# pitchfork watches port 3000 (the OpenChamber UI), not 4096. An unsupervised
# `opencode serve` started by a client during a restart makes the child fail to
# bind (seen on 2026-10-29). This oneshot runs before openchamber and clears
# the port. Pitchfork runs a oneshot again on every start of its dependent, so
# this covers start, restart, boot start and proxy auto-start without any call
# site in the mise hook or the ingress script.
#
# The script leaves a process in the pitchfork tree alone: the OpenChamber
# child sits below the supervised `openchamber` process, and `pitchfork start`
# on an already running daemon runs its dependencies first.
run = "{{ home }}/.local/libexec/sklein-devbox/opencode-port-free"
oneshot = true

[daemons.openchamber]
# OpenChamber owns the OpenCode server. It launches `opencode serve` as a
# child, without `--service`: `--service` takes OpenCode's single-writer lease,
# so another `--service` server would displace the child. The
# `opencode-service-publish` daemon mirrors the child into
# ~/.local/state/opencode/service.json instead, so the TUI and CLI discover it
# without a client-side flag or password variable.
#
# `mise` is spelled out because systemd starts the supervisor without the
# shell's PATH: ~/.local/bin is absent from the unit environment, so a bare
# `mise` would not resolve at boot. The PATH below also lets MCP servers
# declared as `mise exec -- …` resolve ~/.local/bin.
run = """
export XDG_RUNTIME_DIR=/tmp/user/1000
export GOPASS_AGE_NO_CONFIRM=1
export PATH="{{ home }}/.local/bin:$PATH"
export OPENCODE_PORT=4096
export OPENCODE_SERVER_PASSWORD={{ secret(name="OPENCODE_SERVER_PASSWORD") }}
OPENCHAMBER_UI_PASSWORD={{ secret(name="OPENCHAMBER_UI_PASSWORD") }}
export OPENCHAMBER_UI_PASSWORD
exec {{ mise_bin }} exec -- openchamber --lan --port 3000 --foreground
"""
retry = true
depends = ["opencode-port-free", "opencode-service-publish"]
port = 3000
boot_start = true

[daemons.openchamber.env]
# Node does not read the Fedora trust store. `--use-openssl-ca` makes it use the
# OpenSSL default paths, which on Fedora point at the ca-trust bundle, so the
# `*.sklein.internal` certificates validate for `webfetch` and the SearXNG MCP
# server. The CA itself is installed by `~/bin/install-homelab-ca` from gopass;
# no copy of it is deployed with the dotfiles. The OpenCode child inherits this
# variable from OpenChamber.
NODE_OPTIONS = "--use-openssl-ca"

[daemons.opencode-service-publish]
# Publish the OpenCode server OpenChamber launches, so the TUI and CLI discover
# it through ~/.local/state/opencode/service.json. The child runs without
# `--service`, so it never takes OpenCode's single-writer lease. The daemon
# reads the child's pid, port, version and password, writes the registration
# atomically, and overwrites a registration written by a client `--service`
# server. It has no port of its own; pitchfork starts it before openchamber
# because openchamber depends on it.
run = "{{ home }}/.local/libexec/sklein-devbox/opencode-service-publish --watch"
retry = true
boot_start = true

[daemons.opentab]
run = "{{ mise_bin }} exec -- opentab web --bind 0.0.0.0 --port=8321 --headless"
retry = true
port = 8321
boot_start = false

# --- sklein-devbox-ingress ---------------------------------------------------
# Wildcard subdomains over NetBird + a per-hostname TLS reverse proxy in front
# of the daemons above. Driven by ~/bin/sklein-devbox-ingress (up/down/status).
#
#   - dnsmasq answers *.<tld> (any depth) with the wt0 address; every NetBird
#     peer reaches it through the nameserver group the script maintains via the
#     API. <tld> sits outside the peer DNS domain on purpose: NetBird is
#     authoritative over that domain and never forwards below it to a
#     nameserver, so a nameserver group there would be dead config.
#   - the proxy routes <daemon>.<project>.<tld>, plus any extra label on the
#     left (proxy.wildcard), and signs a per-hostname certificate with its
#     local CA ($PITCHFORK_STATE_DIR/proxy/ca.pem, to distribute to clients).
#
# `host = "0.0.0.0"` lets the proxy listen on the (dynamic) wt0 address so
# NetBird peers can reach it; it therefore also listens on the other
# interfaces. `port = 443` relies on the bind capability granted once by
# `pitchfork proxy setup` (re-run by the script's `up`).
[settings.proxy]
enable = true
https = true
tld = "{{ tld }}"
wildcard = true
host = "0.0.0.0"
port = 443

# DNS wildcard for the proxy TLD. `--address=/<tld>/<ip>` matches the domain
# and every subdomain at any depth. `--conf-file=/dev/null` keeps Fedora's
# /etc/dnsmasq.conf out of the picture (it sets `local-service`, which would
# restrict who may query this daemon). The run script computes the wt0 address
# at start, so `up` must run after `netbird up`.
[daemons.sklein-devbox-ingress-dns]
run = '''
IP="$(/usr/sbin/ip -4 -o addr show wt0 | awk 'NR==1{split($4,a,"/");print a[1]}')"
[ -n "$IP" ] || { echo "sklein-devbox-ingress-dns: wt0 has no IPv4 (is netbird up?)" >&2; exit 1; }
exec /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/dev/null --port=5353 \
  --listen-address="$IP" --listen-address=127.0.0.1 --bind-interfaces \
  --no-resolv --no-hosts --domain-needed \
  --address=/.{{ tld }}/$IP
'''
retry = true
# Keep the daemon running across a supervisor restart: a daemon started only
# through `pitchfork start` (on the CLI) is not re-adopted after
# `pitchfork supervisor start --force`.
boot_start = true

# Route the global daemons above through the proxy. Global daemons have no
# project hostname, so they need a slug; <slug>.<tld> resolves like any other
# name under the TLD.
#
# `dir` must be the directory the daemon actually runs from, which for a daemon
# declared in this file is this file's own directory. It is not decoration:
# the proxy builds its project registry from the slug dirs (plus `[namespaces]`
# and the daemons' recorded dirs), so a dir of `~` would register /home/devbox
# as a project named `devbox`. That checkout would then claim the same
# `global/...` daemon IDs as this one, and the proxy would refuse
# `openchamber.devbox.<tld>` as "other checkout" (502, or "is not available"
# for a remote client). With the dir below, the only URL is `openchamber.<tld>`
# (and the incidental `openchamber.pitchfork.<tld>`); no `devbox` hostname is
# advertised.
[slugs]
openchamber     = { dir = "~/.config/pitchfork", daemon = "openchamber" }
opentab         = { dir = "~/.config/pitchfork", daemon = "opentab" }
