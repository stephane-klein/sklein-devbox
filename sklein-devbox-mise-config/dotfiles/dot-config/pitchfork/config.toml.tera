#- The proxy TLD is the instance namespace, not the host FQDN: each instance
#   exposes <daemon>.<project>.<instance>.<ingress_domain>. It must stay
#   OUTSIDE the NetBird peer DNS domain (homelab.stephane-klein.info): NetBird
#   is authoritative over that domain and never forwards a name below it to a
#   nameserver, so the wildcard DNS relies on a nameserver group, which is only
#   consulted for a foreign domain. `~/bin/sklein-devbox-ingress` computes the
#   same value from `hostname -s` and the same `ingress_domain` literal.
{%- set instance = exec(command="hostname -s") -%}
{%- set ingress_domain = "devbox.sklein.xyz" -%}
{%- set tld = instance ~ "." ~ ingress_domain %}
{%- if "." in instance or instance == "" %}{{ throw(message="pitchfork config.toml: `hostname -s` did not return a single label") }}{% endif %}

[settings.web]
auto_start = true
bind_port = 3120
bind_address = "127.0.0.1"

[daemons.chromium-headless]
run = """
chromium-browser --headless=new  --remote-debugging-port=9222  --remote-debugging-address=0.0.0.0  --remote-allow-origins="*"  --no-sandbox --window-size=1920,1200 --use-gl=angle --use-angle=swiftshader
"""
retry = true

[daemons.opencode-server]
# OpenCode 2: `serve --service` runs the shared server in the foreground and
# registers it in ~/.local/state/opencode/service.json, so every client (TUI,
# CLI, OpenChamber) discovers its URL and password without any flag. Port,
# hostname and password come from `opencode service set` (see the mise
# post-dotfiles hook); pitchfork keeps the process supervised and logs it.
run = "mise exec -- opencode serve --service"
retry = true
# Readiness: pitchfork starts dependents (openchamber) once the port listens.
port = 4096
# Come back with the supervisor: without this, a `supervisor start --force`
# (e.g. reloading the proxy TLD) leaves the server down, and the next OpenCode
# client starts an unsupervised `serve --service` that then holds port 4096,
# making every later `pitchfork start global/opencode-server` fail.
boot_start = true

[daemons.openchamber]
run = """
export XDG_RUNTIME_DIR=/tmp/user/1000
export GOPASS_AGE_NO_CONFIRM=1
export OPENCODE_SKIP_START=true
export OPENCODE_PORT=4096
export OPENCODE_SERVER_PASSWORD={{ secret(name="OPENCODE_SERVER_PASSWORD") }}
OPENCHAMBER_UI_PASSWORD={{ secret(name="OPENCHAMBER_UI_PASSWORD") }}
export OPENCHAMBER_UI_PASSWORD
exec mise exec -- openchamber --lan --port 3000 --foreground
"""
retry = true
depends = ["opencode-server"]
port = 3000
boot_start = true

# --- sklein-devbox-ingress ---------------------------------------------------
# Wildcard subdomains over NetBird + a per-hostname TLS reverse proxy in front
# of the daemons above. Driven by ~/bin/sklein-devbox-ingress (up/down/status).
#
#   - dnsmasq answers *.<tld> (any depth) with the wt0 address; every NetBird
#     peer reaches it through the nameserver group the script maintains via the
#     API. <tld> sits outside the peer DNS domain on purpose: NetBird is
#     authoritative over that domain and never forwards below it to a
#     nameserver, so a nameserver group there would be dead config.
#   - the proxy routes <daemon>.<project>.<tld>, plus any extra label on the
#     left (proxy.wildcard), and signs a per-hostname certificate with its
#     local CA ($PITCHFORK_STATE_DIR/proxy/ca.pem, to distribute to clients).
#
# `host = "0.0.0.0"` lets the proxy listen on the (dynamic) wt0 address so
# NetBird peers can reach it; it therefore also listens on the other
# interfaces. `port = 443` relies on the bind capability granted once by
# `pitchfork proxy setup` (re-run by the script's `up`).
[settings.proxy]
enable = true
https = true
tld = "{{ tld }}"
wildcard = true
host = "0.0.0.0"
port = 443

# DNS wildcard for the proxy TLD. `--address=/<tld>/<ip>` matches the domain
# and every subdomain at any depth. `--conf-file=/dev/null` keeps Fedora's
# /etc/dnsmasq.conf out of the picture (it sets `local-service`, which would
# restrict who may query this daemon). The run script computes the wt0 address
# at start, so `up` must run after `netbird up`.
[daemons.sklein-devbox-ingress-dns]
run = '''
IP="$(/usr/sbin/ip -4 -o addr show wt0 | awk 'NR==1{split($4,a,"/");print a[1]}')"
[ -n "$IP" ] || { echo "sklein-devbox-ingress-dns: wt0 has no IPv4 (is netbird up?)" >&2; exit 1; }
exec /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/dev/null --port=5353 \
  --listen-address="$IP" --listen-address=127.0.0.1 --bind-interfaces \
  --no-resolv --no-hosts --domain-needed \
  --address=/.{{ tld }}/$IP
'''
retry = true
# Keep the daemon running across a supervisor restart: a daemon started only
# through `pitchfork start` (on the CLI) is not re-adopted after
# `pitchfork supervisor start --force`.
boot_start = true

# Route the global daemons above through the proxy. Global daemons have no
# project hostname, so they need a slug; <slug>.<tld> resolves like any other
# name under the TLD.
[slugs]
openchamber     = { dir = "~", daemon = "openchamber" }
