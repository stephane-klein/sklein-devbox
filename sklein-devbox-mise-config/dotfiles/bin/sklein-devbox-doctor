#!/usr/bin/env bash
# sklein-devbox-doctor - end-to-end check of the instance side of the
# remote-desktop link (the foot host -> instance reverse carrier).
#
# Runs `mise doctor`, then walks through the capabilities the link provides: a
# desktop notification, audio playback and URL opening -- plus a transport-aware
# clipboard (OSC 52) check, which does not depend on the link carrier. For each
# it runs the command and asks whether the effect was perceived, so a transport
# failure (missing socket, no carrier) is reported apart from a perception one.
#
# See sklein-devbox-mise-config/README.md and the foot-link systemd user unit
# created by `sklein-devbox foot-link` on the foot host.

set -u

PROG="${0##*/}"
SOUND_DEFAULT="${XDG_DATA_HOME:-$HOME/.local/share}/sklein-devbox/sounds/door-bell.ogg"
URL_DEFAULT="https://github.com/stephane-klein/sklein-devbox"

SOUND="$SOUND_DEFAULT"
URL="$URL_DEFAULT"
RUN_MISE_DOCTOR=1
# Empty runs every check; otherwise the name of the single check to run.
ONLY=""

BUS_SOCKET=/tmp/foot-host-bus
PULSE_SOCKET=/tmp/foot-host-pulse

pass=0
fail=0
skip=0

if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_FAIL=$'\033[31m'; C_OFF=$'\033[0m'
else
  C_OK=; C_FAIL=; C_OFF=
fi

usage() {
  cat <<EOF
$PROG - check the sklein-devbox remote-desktop link from inside the instance.

Runs \`mise doctor\`, then guides you through the link checks (a desktop
notification, an audio playback and opening a URL) and a clipboard (OSC 52)
check, asking after each whether you perceived the effect on the foot host.

Usage:
  $PROG [options]

Options:
  -h, --help              Show this help
      --url URL           URL to open (default: $URL_DEFAULT)
      --sound FILE        Audio file to play (default: $SOUND_DEFAULT)
      --skip-mise         Do not run \`mise doctor\`
      --only-mise         Run only \`mise doctor\`
      --only-notification Run only the notification check
      --only-sound        Run only the sound check
      --only-url          Run only the opening-URL check
      --only-clipboard    Run only the clipboard (OSC 52) checks
EOF
}

die() { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 2; }

step() { printf '\n== %s\n' "$1"; }
record_pass() { printf '   %sok%s   %s\n' "$C_OK" "$C_OFF" "$1"; pass=$((pass + 1)); }
record_fail() { printf '   %sfail%s %s\n' "$C_FAIL" "$C_OFF" "$1"; fail=$((fail + 1)); }
record_skip() { printf '   skip %s\n' "$1"; skip=$((skip + 1)); }

ask() { # ask "question" -> success on yes
  local answer
  printf '   %s [y/N] ' "$1"
  IFS= read -r answer || return 1
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

require_tty() {
  [ -t 0 ] || die "run this from an interactive session (e.g. the tmux console, or: ssh -t <instance> $PROG)"
}

# want CHECK -> true when running every check, or only the named one
want() { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }

# --- clipboard (OSC 52) ------------------------------------------------------
NVIM_OPTIONS="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lua/config/options.lua"
ZSHRC="$HOME/.zshrc"

tok() { printf 'skd-%s-%s-%s' "$1" "$RANDOM" "$$"; }

# ssh vs mosh: the tmux client TERM (foot = ssh, xterm-256color = mosh),
# falling back to the presence of a mosh-server process.
detect_transport() {
  local term=""
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    term="$(tmux display-message -p '#{client_termname}' 2>/dev/null || true)"
  fi
  case "$term" in
    foot*) printf ssh; return ;;
    "") ;;
    *) printf mosh; return ;;
  esac
  if command -v pgrep >/dev/null 2>&1 && pgrep -x mosh-server >/dev/null 2>&1; then
    printf mosh
  else
    printf ssh
  fi
}

clip_opt() { tmux show-options -gqv "$1" 2>/dev/null || true; }
nvim_provider() {
  grep -oE 'vim\.g\.clipboard = "[^"]+"' "$NVIM_OPTIONS" 2>/dev/null \
    | head -1 | sed -E 's/.*"([^"]+)".*/\1/'
}
opencode_alias() { grep -q "alias opencode='TMUX=" "$ZSHRC" 2>/dev/null && printf yes || printf no; }

# Guided check: "expected" is ok (both transports) or mosh-only-fail (host ->
# app clipboard read, which mosh cannot relay).
check() {
  local label="$1" expected="${2:-ok}"
  if ask "$label"; then
    record_pass "$label"
  elif [ "$expected" = mosh-only-fail ]; then
    record_skip "$label (expected: mosh cannot read the host clipboard)"
  else
    record_fail "$label"
  fi
}

run_mise_doctor() {
  step "mise doctor"
  if ! command -v mise >/dev/null 2>&1; then
    record_skip "mise not found in PATH"
    return
  fi
  if mise doctor; then
    record_pass "mise doctor"
  else
    record_fail "mise doctor reported problems"
  fi
}

env_summary() {
  step "remote-desktop link environment"
  local missing=0
  if [ -S "$BUS_SOCKET" ]; then
    printf '   bus socket    %s\n' "$BUS_SOCKET"
    # The host bus is no longer in the ambient environment (a foreign
    # DBUS_SESSION_BUS_ADDRESS breaks podman's systemd sandbox cgroup; see
    # files/ssh-tmux-login). Set it for the link checks below.
    DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS_SOCKET"
    export DBUS_SESSION_BUS_ADDRESS
  else
    printf '   bus socket    %s (missing)\n' "$BUS_SOCKET"
    missing=$((missing + 1))
  fi
  if [ -S "$PULSE_SOCKET" ]; then
    printf '   pulse socket  %s\n' "$PULSE_SOCKET"
  else
    printf '   pulse socket  %s (missing)\n' "$PULSE_SOCKET"
    missing=$((missing + 1))
  fi
  printf '   host bus env  %s (not exported to podman)\n' "${DBUS_SESSION_BUS_ADDRESS:-(unset)}"
  printf '   PULSE_SERVER=%s\n' "${PULSE_SERVER:-(unset)}"
  if (( missing == 2 )); then
    printf '\n   The remote-desktop link is not up. On the foot host run:\n' >&2
    printf '     sklein-devbox foot-link\n' >&2
    exit 2
  fi
}

test_notification() {
  step "1/3 notification"
  if ! command -v notify-send >/dev/null 2>&1; then
    record_skip "notify-send not installed"
    return
  fi
  if notify-send -a "$PROG" "sklein-devbox-doctor" \
       "Notification test: if you see this, notifications work."; then
    if ask "Did you see the notification?"; then
      record_pass "notification perceived"
    else
      record_fail "notification sent but not seen"
    fi
  else
    record_fail "notify-send failed (session bus unreachable?)"
  fi
}

test_sound() {
  step "2/3 sound"
  if ! command -v paplay >/dev/null 2>&1; then
    record_skip "paplay not installed"
    return
  fi
  if [ ! -f "$SOUND" ]; then
    record_skip "sound file not found: $SOUND"
    return
  fi
  if command -v pactl >/dev/null 2>&1 && ! pactl info >/dev/null 2>&1; then
    record_fail "pulse server unreachable (pactl info failed)"
    return
  fi
  if paplay "$SOUND"; then
    if ask "Did you hear the sound?"; then
      record_pass "sound perceived"
    else
      record_fail "sound played but not heard"
    fi
  else
    record_fail "paplay failed to play $SOUND"
  fi
}

test_url() {
  step "3/3 open URL"
  if ! command -v xdg-open >/dev/null 2>&1; then
    record_skip "xdg-open not found"
    return
  fi
  if command -v gdbus >/dev/null 2>&1; then
    gdbus call --session --dest org.freedesktop.DBus \
      --object-path /org/freedesktop/DBus \
      --method org.freedesktop.DBus.ListNames >/dev/null 2>&1 \
      || { record_fail "session bus unreachable (gdbus)"; return; }
  fi
  xdg-open "$URL" >/dev/null 2>&1
  if ask "Did $URL open in your browser?"; then
    record_pass "URL opened"
  else
    record_fail "URL not opened"
  fi
}

test_clipboard() {
  step "clipboard (OSC 52)"
  local transport t
  transport="$(detect_transport)"
  printf '   transport      %s\n' "$transport"
  printf '   set-clipboard  %s\n' "$(clip_opt set-clipboard)"
  printf '   get-clipboard  %s\n' "$(clip_opt get-clipboard)"
  printf '   neovim         %s\n' "$(nvim_provider)"
  printf '   opencode       %s\n' "$(opencode_alias)"
  if [ "$transport" = mosh ]; then
    printf '   note           mosh relays OSC 52 writes only: host -> instance paste fails\n'
  fi

  if ! command -v tmux >/dev/null 2>&1; then
    record_skip "tmux not found (run from the tmux console)"
    return
  fi

  step "clipboard 1/6 tmux -> host (copy)"
  t="$(tok t2h)"; printf '   token: %s\n' "$t"
  check "copy $t in tmux (copy-mode) and paste it on the host"

  step "clipboard 2/6 nvim -> host (copy)"
  t="$(tok n2h)"; printf '   token: %s\n' "$t"
  check "type $t in nvim, yank it with \"+y, then paste it on the host"

  step "clipboard 3/6 opencode -> host (copy)"
  t="$(tok o2h)"; printf '   token: %s\n' "$t"
  check "copy $t in opencode, then paste it on the host"

  step "clipboard 4/6 host -> tmux (terminal paste)"
  t="$(tok h2t)"; printf '   copy %s on the host, then Ctrl+Shift+V into a tmux pane\n' "$t"
  check "paste $t into a tmux pane with Ctrl+Shift+V"

  step "clipboard 5/6 host -> nvim (\"+p)"
  t="$(tok h2n)"; printf '   copy %s on the host, then press \"+p in nvim\n' "$t"
  if [ "$transport" = mosh ]; then
    check "paste $t in nvim with \"+p" mosh-only-fail
  else
    check "paste $t in nvim with \"+p"
  fi

  step "clipboard 6/6 host -> opencode (terminal paste)"
  t="$(tok h2o)"; printf '   copy %s on the host, then Ctrl+Shift+V in opencode\n' "$t"
  check "paste $t into opencode with Ctrl+Shift+V"
}

main() {
  printf '%s - remote-desktop link check\n' "$PROG"

  require_tty

  local need_link=0
  if [ -z "$ONLY" ]; then
    need_link=1
  else
    case "$ONLY" in
      notification|sound|url) need_link=1 ;;
    esac
  fi

  if want mise && (( RUN_MISE_DOCTOR )); then
    run_mise_doctor
  fi
  if want clipboard; then
    test_clipboard
  fi
  if (( need_link )); then
    env_summary
  fi

  if want notification; then test_notification; fi
  if want sound; then test_sound; fi
  if want url; then test_url; fi

  step "summary"
  printf '   %d ok, %d failed, %d skipped\n' "$pass" "$fail" "$skip"
  if (( fail )); then
    printf '   %sfailed%s\n' "$C_FAIL" "$C_OFF"
    exit 1
  fi
  printf '   %sall good%s\n' "$C_OK" "$C_OFF"
  exit 0
}

while (( $# )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --url) URL="${2:?--url requires a value}"; shift 2 ;;
    --url=*) URL="${1#*=}"; shift ;;
    --sound) SOUND="${2:?--sound requires a value}"; shift 2 ;;
    --sound=*) SOUND="${1#*=}"; shift ;;
    --skip-mise) RUN_MISE_DOCTOR=0; shift ;;
    --only-mise) ONLY=mise; shift ;;
    --only-notification) ONLY=notification; shift ;;
    --only-sound) ONLY=sound; shift ;;
    --only-url) ONLY=url; shift ;;
    --only-clipboard) ONLY=clipboard; shift ;;
    *) die "unknown option '$1'" ;;
  esac
done

main "$@"
